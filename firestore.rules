rules_version = '2';

// Cada persona lee y escribe lo suyo, dentro de users/{suId}.
// Excepción: una nutricionista activa ve los datos de sus clientes
// solo mientras el vínculo esté activo. El vínculo lo crea el cliente al ingresar el código (así da su permiso)
// y cualquiera de los dos lo puede cortar.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return conSesion() && request.auth.uid == uid;
    }

    // Cargadores: pueden leer etiquetas con foto y verificar o corregir productos de la base compartida
    function esCargador() {
      return conSesion() && (esAdmin() || (exists(/databases/$(database)/documents/config/cargadores)
        && request.auth.uid in get(/databases/$(database)/documents/config/cargadores).data.uids));
    }

    // Producto de la base compartida: el id del documento ES el código de barras
    function productoValido(codigo) {
      let d = request.resource.data;
      return d.keys().hasOnly(['codigo', 'nombre', 'marca', 'por100', 'porciones', 'verificado', 'creadoPor', 'creado', 'actualizado', 'verificadoPor', 'via', 'prefijos'])
        && d.codigo == codigo && codigo.matches('^([0-9]{8}|[0-9]{12,14})$')
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && (!('marca' in d) || (d.marca is string && d.marca.size() <= 60))
        && d.por100.kcal is number && d.por100.kcal >= 0 && d.por100.kcal <= 1000
        && d.porciones is list && d.porciones.size() > 0 && d.porciones.size() <= 8
        && d.verificado is bool && d.creadoPor is string
        && (!('prefijos' in d) || (d.prefijos is list && d.prefijos.size() <= 60));
    }

    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function profesionalActivo(pid) {
      let p = /databases/$(database)/documents/profesionales/$(pid);
      return exists(p) && get(p).data.activo == true;
    }

    // ¿Quien pide es el profesional de este cliente, con vínculo activo?
    function esSuProfesional(uid) {
      let v = /databases/$(database)/documents/vinculos/$(request.auth.uid + '_' + uid);
      return conSesion() && request.auth.uid != uid && exists(v) && get(v).data.activo == true
        && profesionalActivo(request.auth.uid);
    }

    function puedeVer(uid) {
      return esDueno(uid) || esSuProfesional(uid);
    }

    // Solo cambian estas claves respecto de lo guardado
    function soloCambia(claves) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(claves);
    }

    function perfilValido(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'nombre', 'email', 'tema', 'acento', 'unidad', 'recordatorio', 'creado', 'resumen',
          'conocido', 'genero', 'nacimiento', 'altura', 'actividad', 'objetivo', 'metas', 'metasManual', 'favoritos', 'comidas', 'foto'])
        && (!('foto' in d) || d.foto == null || (d.foto is string && d.foto.size() <= 100000 && d.foto.matches('data:image/(webp|jpeg);base64,.*')))
        && (!('uid' in d) || d.uid == uid)
        && (!('nombre' in d) || (d.nombre is string && d.nombre.size() <= 80))
        && (!('tema' in d) || d.tema in ['claro', 'oscuro', 'sistema'])
        && (!('acento' in d) || d.acento in ['oliva', 'terracota', 'bronce'])
        && (!('unidad' in d) || d.unidad in ['kg', 'lb'])
        && (!('resumen' in d) || (d.resumen.dias is list && d.resumen.dias.size() <= 130
            && d.resumen.cumplidos is list && d.resumen.cumplidos.size() <= 130 && d.resumen.total is int))
        && (!('genero' in d) || d.genero in ['hombre', 'mujer'])
        && (!('nacimiento' in d) || (d.nacimiento is string && d.nacimiento.size() == 10))
        && (!('altura' in d) || (d.altura is number && d.altura > 50 && d.altura < 260))
        && (!('actividad' in d) || d.actividad in ['sedentario', 'ligero', 'moderado', 'activo', 'muy-activo'])
        && (!('objetivo' in d) || d.objetivo in ['bajar', 'mantener', 'subir'])
        && (!('metas' in d) || (d.metas.kcal is number && d.metas.kcal > 0 && d.metas.kcal < 10000))
        && (!('metasManual' in d) || d.metasManual is bool)
        && (!('conocido' in d) || d.conocido is bool)
        && (!('favoritos' in d) || (d.favoritos is list && d.favoritos.size() <= 100))
        && (!('comidas' in d) || (d.comidas is list && d.comidas.size() <= 10));
    }

    // Un día del diario: el id es la fecha AAAA-MM-DD
    function diaValido(fecha) {
      let d = request.resource.data;
      return d.fecha == fecha && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // Comidas con nombre propio: hasta 10 de la persona + las quitadas que tenían algo ese día
        && d.comidas is map && d.comidas.size() <= 15
        && d.agua is number && d.agua >= 0 && d.agua <= 10000
        && d.totales is map && d.totales.kcal is number;
    }

    function planValido() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.comidas is map && d.comidas.size() <= 15;
    }

    match /users/{uid} {
      allow get: if puedeVer(uid);
      // El admin solo puede buscar una cuenta por su correo, de a una (para marcar cargadores)
      allow list: if puedeVer(uid) || (esAdmin() && request.query.limit <= 1);
      allow delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && perfilValido(uid);

      // Diario: lo escribe solo la persona; su nutricionista lo lee
      match /days/{fecha} {
        allow read: if puedeVer(uid);
        allow delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && diaValido(fecha);
      }
      match /customFoods/{id} {
        allow read: if puedeVer(uid);
        allow delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
          && request.resource.data.por100.kcal is number && request.resource.data.porciones is list
          && (!('codigo' in request.resource.data) || (request.resource.data.codigo is string && request.resource.data.codigo.size() <= 14))
          && (!('receta' in request.resource.data) || request.resource.data.receta.ingredientes.size() <= 60);
      }
      // Combinaciones guardadas ("Mi desayuno de siempre"): solo la persona
      match /savedMeals/{id} {
        allow read: if puedeVer(uid);
        allow delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
          && request.resource.data.items is list && request.resource.data.items.size() <= 40;
      }
      match /bodyLogs/{id} {
        allow read: if puedeVer(uid);
        allow delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && request.resource.data.fecha is number;
      }
      // Planes: la persona maneja los suyos; los asignados por su nutricionista solo los maneja la nutricionista
      match /plans/{id} {
        allow read: if puedeVer(uid);
        allow create: if planValido() && (
          (esDueno(uid) && !('asignadaPor' in request.resource.data))
          || (esSuProfesional(uid) && request.resource.data.asignadaPor == request.auth.uid));
        allow update: if planValido() && (
          (esDueno(uid) && !('asignadaPor' in resource.data) && !('asignadaPor' in request.resource.data))
          || (esSuProfesional(uid) && resource.data.asignadaPor == request.auth.uid
              && request.resource.data.asignadaPor == request.auth.uid));
        allow delete: if esDueno(uid) || (esSuProfesional(uid) && resource.data.asignadaPor == request.auth.uid);
      }

      // Comentarios entre el profesional y el cliente. Cada uno escribe los suyos; el cliente marca "leído".
      match /comments/{id} {
        allow read: if puedeVer(uid);
        allow create: if puedeVer(uid)
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000;
        allow update: if (esDueno(uid) && soloCambia(['leido']))
          || (puedeVer(uid) && resource.data.autorId == request.auth.uid && soloCambia(['texto', 'leido']));
        allow delete: if esDueno(uid) || (puedeVer(uid) && resource.data.autorId == request.auth.uid);
      }

      // Objetivos: los fija el profesional; el cliente los ve (y puede borrarlos si ya no tiene profesional)
      match /goals/{id} {
        allow read: if puedeVer(uid);
        allow create, update: if esSuProfesional(uid)
          && request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120
          && request.resource.data.tipo in ['frecuencia', 'marca', 'corporal', 'libre'];
        allow delete: if esDueno(uid) || esSuProfesional(uid);
      }
    }

    // Profesionales: los da de alta y de baja solo el admin
    match /profesionales/{pid} {
      allow read: if esDueno(pid) || esAdmin();
      allow write: if esAdmin();
    }

    // Códigos de invitación: se consultan de a uno (no se pueden listar)
    match /codigos/{codigo} {
      allow get: if conSesion();
      allow list: if esAdmin();
      allow write: if esAdmin();
    }

    // Pedido para ser profesional: lo hace el propio usuario; lo resuelve el admin
    match /solicitudes/{uid} {
      allow read: if esDueno(uid) || esAdmin();
      allow create: if esDueno(uid)
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.tipo == 'nutricionista'
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && (!('mensaje' in request.resource.data) || request.resource.data.mensaje.size() <= 500);
      allow update: if esAdmin() || (esDueno(uid) && resource.data.estado == 'rechazada'
        && request.resource.data.estado == 'pendiente');
      allow delete: if esAdmin() || esDueno(uid);
    }

    // Vínculo profesional ↔ cliente
    match /vinculos/{id} {
      allow read: if conSesion() && (resource.data.clienteId == request.auth.uid
        || resource.data.profesionalId == request.auth.uid || esAdmin());
      // Lo crea el cliente con un código válido de un profesional activo
      allow create: if conSesion()
        && request.resource.data.clienteId == request.auth.uid
        && id == request.resource.data.profesionalId + '_' + request.auth.uid
        && request.resource.data.activo == true
        && request.resource.data.profesionalId != request.auth.uid
        && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigo))
        && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.profesionalId == request.resource.data.profesionalId
        && profesionalActivo(request.resource.data.profesionalId);
      // Cualquiera de los dos lo corta; volver a activarlo solo el cliente, con el código vigente
      allow update: if conSesion() && (
        ((resource.data.clienteId == request.auth.uid || resource.data.profesionalId == request.auth.uid || esAdmin())
          && request.resource.data.activo == false && soloCambia(['activo', 'hasta']))
        || (resource.data.clienteId == request.auth.uid && request.resource.data.activo == true
          && request.resource.data.clienteId == resource.data.clienteId
          && request.resource.data.profesionalId == resource.data.profesionalId
          && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigo))
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.profesionalId == request.resource.data.profesionalId
          && profesionalActivo(request.resource.data.profesionalId)));
      allow delete: if false;
    }

    // Lista de admins: la carga el dueño a mano desde la consola de Firebase.
    match /config/admins {
      allow read: if conSesion();
      allow write: if false;
    }

    // Lista de cargadores: la leen todos (para saber si son cargadores); la cambia solo el admin
    match /config/cargadores {
      allow read: if conSesion();
      allow write: if esAdmin() && request.resource.data.keys().hasOnly(['uids', 'info'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 200;
    }

    // Base compartida de productos envasados: un código = un producto
    match /productos/{codigo} {
      allow read: if conSesion();
      // Cualquiera con sesión lo crea si el código no existe; si no es cargador, queda "sin verificar"
      allow create: if conSesion() && productoValido(codigo)
        && request.resource.data.creadoPor == request.auth.uid
        && (request.resource.data.verificado == false || esCargador());
      // Corregir, verificar o borrar: solo cargadores y admin (el código no cambia nunca)
      allow update: if esCargador() && productoValido(codigo) && request.resource.data.codigo == resource.data.codigo;
      allow delete: if esCargador();
    }

    // Reportes de errores en productos: los crea cualquiera con sesión; los ven y borran cargadores y admin
    match /reportes/{id} {
      allow create: if conSesion() && request.resource.data.uid == request.auth.uid
        && request.resource.data.codigo is string && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0 && request.resource.data.motivo.size() <= 300;
      allow read, delete: if esCargador();
    }
  }
}
